#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

python3 - "$@" <<'PY'
from pathlib import Path
import re
import sys
import unicodedata

args = sys.argv[1:]
check_only = "--check" in args
unknown = [arg for arg in args if arg != "--check"]
if unknown:
    print(f"usage: s/gen-indexes [--check]\nunknown argument(s): {', '.join(unknown)}")
    sys.exit(2)

content_root = Path("recipes")
readme_path = Path("README.md")
banner = "<!-- Generated by s/gen-indexes. Do not edit by hand. -->"
readme_begin = "<!-- BEGIN GENERATED INDEX (s/gen-indexes) -->"
readme_end = "<!-- END GENERATED INDEX -->"

# Sections are curated once here; the recipe lists below them are generated from
# the files on disk, so adding a recipe never means editing an index by hand.
sections = [
    {
        "folder": "baking",
        "title": "Baking & Sweets",
        "category": "Baking & Sweets",
        "tags": ["baking", "sweets", "index"],
        "noun": "recipes",
        "intro": (
            "Breads, biscuits, cakes, puddings and confectionery. Mostly things "
            "that need an oven, a bit of patience, or both."
        ),
        "readme": "list",
    },
    {
        "folder": "basics",
        "title": "Basics & Staples",
        "category": "Basics & Staples",
        "tags": ["basics", "staples", "index"],
        "noun": "recipes",
        "intro": (
            "The building blocks: doughs, flatbreads, pasta, sauces and other "
            "components that other recipes lean on."
        ),
        "readme": "list",
    },
    {
        "folder": "brewing",
        "title": "Brewing",
        "category": "Brewing",
        "tags": ["brewing", "fermentation", "index"],
        "noun": "recipes",
        "intro": (
            "Beers, country wines, infusions and other fermented drinks, along "
            "with the process notes that go with them."
        ),
        "readme": "list",
    },
    {
        "folder": "cocktails",
        "title": "Cocktails",
        "category": "Drinks",
        "tags": ["cocktails", "drinks", "index"],
        "noun": "cocktails",
        "intro": (
            "Classic and modern mixed drinks, each with ingredients, method and "
            "garnish. Measures are metric-first; a standard measure is 25 ml."
        ),
        "readme": "link",
    },
    {
        "folder": "guides",
        "title": "Guides",
        "category": "Guides",
        "tags": ["guides", "technique", "index"],
        "noun": "guides",
        "intro": "Longer-form technique references rather than single recipes.",
        "readme": "list",
    },
    {
        "folder": "misc",
        "title": "Utility & Misc",
        "category": "Utility & Misc",
        "tags": ["utility", "diy", "index"],
        "noun": "pages",
        "intro": (
            "Household and workshop formulas, equipment builds, and the food "
            "projects that do not sit neatly anywhere else."
        ),
        "readme": "list",
    },
    {
        "folder": "preserves",
        "title": "Preserves & Condiments",
        "category": "Preserves & Condiments",
        "tags": ["preserves", "condiments", "index"],
        "noun": "recipes",
        "intro": (
            "Jams, chutneys, pickles, ferments, sauces and dressings: anything "
            "made to keep, or made to go alongside something else."
        ),
        "readme": "list",
    },
    {
        "folder": "savoury",
        "title": "Savoury Dishes",
        "category": "Savoury Dishes",
        "tags": ["savoury", "mains", "index"],
        "noun": "recipes",
        "intro": "Soups, stews, roasts, pasta, curries and everyday main courses.",
        "readme": "list",
    },
]

# Directories under recipes/ that hold site furniture rather than content.
non_section_dirs = {"assets", "styles"}
# Above this many entries a flat list stops being browsable, so group by letter.
group_threshold = 30


def read_frontmatter(path: Path) -> dict[str, str]:
    """Parse the top-level keys of a file's YAML frontmatter block."""
    lines = path.read_text(encoding="utf-8").splitlines()
    if not lines or lines[0] != "---":
        return {}

    try:
        end = lines[1:].index("---") + 1
    except ValueError:
        return {}

    keys: dict[str, str] = {}
    for line in lines[1:end]:
        if not line.strip() or line.startswith(" ") or ":" not in line:
            continue
        key, value = line.split(":", 1)
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "'\"":
            value = value[1:-1]
        keys[key.strip()] = value
    return keys


def sort_key(title: str) -> str:
    """Sort titles case-, accent- and article-insensitively."""
    folded = unicodedata.normalize("NFKD", title)
    folded = "".join(char for char in folded if not unicodedata.combining(char))
    folded = re.sub(r"[^a-z0-9 ]", "", folded.lower()).strip()
    folded = re.sub(r"^(?:the|a|an) ", "", folded)
    return folded


def group_letter(key: str) -> str:
    """Return the A-Z heading an entry belongs under, or # for anything else."""
    first = key[:1].upper()
    return first if "A" <= first <= "Z" else "#"


def collect(section: dict) -> list[dict[str, str]]:
    """Collect the recipes of a section, sorted by title."""
    directory = content_root / section["folder"]
    entries = []
    for path in sorted(directory.glob("*.md")):
        if path.name in ("index.md", "README.md"):
            continue
        frontmatter = read_frontmatter(path)
        title = frontmatter.get("title") or path.stem.replace("-", " ").title()
        entries.append(
            {
                "title": title,
                "name": path.name,
                "path": path.as_posix(),
                "featured": frontmatter.get("featured", "").lower() == "true",
                "key": sort_key(title),
            }
        )
    return sorted(entries, key=lambda entry: (entry["key"], entry["name"]))


def render_section_index(section: dict, entries: list[dict[str, str]]) -> str:
    """Render the Markdown landing page for one section."""
    count = len(entries)
    noun = section["noun"] if count != 1 else section["noun"].rstrip("s")
    tags = ", ".join(section["tags"])

    out = [
        "---",
        f"slug: {section['folder']}",
        f"title: {section['title']}",
        f"tags: [{tags}]",
        f"category: {section['category']}",
        "---",
        "",
        banner,
        "",
        f"# {section['title']}",
        "",
        section["intro"],
        "",
        f"{count} {noun} in this section, listed alphabetically.",
        "",
    ]

    featured = [entry for entry in entries if entry["featured"]]
    if featured:
        out += ["## Highlights", ""]
        out += [f"- [{entry['title']}]({entry['name']})" for entry in featured]
        out += [""]

    if count > group_threshold:
        letter = None
        for entry in entries:
            current = group_letter(entry["key"])
            if current != letter:
                letter = current
                if out[-1] != "":
                    out.append("")
                out += [f"## {letter}", ""]
            out.append(f"- [{entry['title']}]({entry['name']})")
        out.append("")
    else:
        out += [f"## All {section['noun']}", ""]
        out += [f"- [{entry['title']}]({entry['name']})" for entry in entries]
        out += [""]

    return "\n".join(out)


def render_readme_index(collected: dict[str, list[dict[str, str]]]) -> str:
    """Render the generated recipe index block for the repository README."""
    out = [
        readme_begin,
        "",
        (
            "Every section below is also published as a landing page on the "
            "site, for example <https://pacharanero.github.io/recipes/baking/>."
        ),
        "",
    ]

    for section in sections:
        entries = collected[section["folder"]]
        out += [f"## {section['title']}", ""]
        if section["readme"] == "link":
            out += [
                f"See the dedicated [{section['title']} index]"
                f"(recipes/{section['folder']}/index.md) for all "
                f"{len(entries)} {section['noun']}.",
                "",
            ]
            continue
        out += [f"- [{entry['title']}]({entry['path']})" for entry in entries]
        out += [""]

    out += [readme_end]
    return "\n".join(out)


def replace_readme_block(text: str, block: str) -> str:
    """Swap the generated block inside the README, keeping the prose around it."""
    start = text.find(readme_begin)
    end = text.find(readme_end)
    if start == -1 or end == -1:
        raise SystemExit(
            f"{readme_path}: missing {readme_begin} / {readme_end} markers"
        )
    return text[:start] + block + text[end + len(readme_end):]


unknown_dirs = sorted(
    path.name
    for path in content_root.iterdir()
    if path.is_dir()
    and path.name not in non_section_dirs
    and path.name not in {section["folder"] for section in sections}
)
if unknown_dirs:
    print(
        "Unknown content directories (add them to s/gen-indexes): "
        + ", ".join(unknown_dirs)
    )
    sys.exit(1)

collected = {section["folder"]: collect(section) for section in sections}

wanted: dict[Path, str] = {}
for section in sections:
    index_path = content_root / section["folder"] / "index.md"
    wanted[index_path] = render_section_index(section, collected[section["folder"]])

readme_text = readme_path.read_text(encoding="utf-8")
wanted[readme_path] = replace_readme_block(
    readme_text, render_readme_index(collected)
)

stale = [
    path
    for path, text in wanted.items()
    if not path.exists() or path.read_text(encoding="utf-8") != text
]

if check_only:
    if stale:
        print("Generated indexes are out of date:\n")
        for path in stale:
            print(f"- {path}")
        print("\nRun s/gen-indexes and commit the result.")
        sys.exit(1)
    print("Generated indexes are up to date.")
    sys.exit(0)

for path in stale:
    path.write_text(wanted[path], encoding="utf-8")

if stale:
    print("Wrote:\n")
    for path in stale:
        print(f"- {path}")
else:
    print("Generated indexes are already up to date.")
PY
